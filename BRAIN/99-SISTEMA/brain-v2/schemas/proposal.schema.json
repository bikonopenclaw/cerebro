{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-v2-proposal.schema.json",
  "title": "Brain v2 Proposal Envelope",
  "type": "object",
  "required": [
    "proposal_id",
    "producer",
    "source",
    "target_note",
    "operation",
    "reason",
    "confidence",
    "suggested_relations"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "target_note": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "supersede",
        "link",
        "quarantine",
        "reject"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "suggested_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target",
          "reason"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "approval_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "quarantined",
        "deferred"
      ]
    }
  },
  "additionalProperties": false
}
