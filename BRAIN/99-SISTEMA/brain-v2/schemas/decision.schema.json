{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-v2-decision.schema.json",
  "title": "Brain v2 Decision Record",
  "allOf": [
    {
      "$ref": "brain-v2-note.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "schema_version",
    "status",
    "context",
    "decision",
    "rationale"
  ],
  "properties": {
    "type": {
      "const": "decision"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
