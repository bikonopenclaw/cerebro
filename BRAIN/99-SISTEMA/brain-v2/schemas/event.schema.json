{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-v2-event.schema.json",
  "title": "Brain v2 Event",
  "allOf": [
    {
      "$ref": "brain-v2-note.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "created",
    "schema_version",
    "occurred_at",
    "actor",
    "source"
  ],
  "properties": {
    "type": {
      "const": "event"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "before_ref": {
      "type": "string"
    },
    "after_ref": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
